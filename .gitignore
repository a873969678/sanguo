# 本地运行缓存与日志
.cache/
__pycache__/
*.pyc
*.pyo
*.log

# 短剧工具的本机锁与 Dashboard 会话
/.short-drama/project.lock
/.short-drama/dashboard.json

# 制作过程视频在本地或独立备份中保存。
# 音频、图片、封面、字幕以及 JSON/JSONL 制作记录继续跟踪。
/剧集/*/制作成果/**/*.mp4
/剧集/*/制作成果/**/*.mov
/剧集/*/制作成果/**/*.mkv
/剧集/*/制作成果/**/*.webm
/剧集/*/制作成果/**/*.m4v
/剧集/*/制作成果/**/*.avi

# 已完成的完整配乐成品视频纳入 Git LFS；粗剪与分段视频仍忽略。
!/剧集/*/制作成果/成片/*完整配乐*.mp4

# 公共素材/中的角色、武器、风格与固定声线继续使用 Git LFS。
# .agents/skills/ 技能源码和 .short-drama/ 制作账目继续跟踪。
