  "members": [
    {
      "shot": "SHOT-EP001-018",
      "source_scene": "EP001-SC003",
      "name": "你卖的是豆还是粉",
      "start_seconds": 0,
      "end_seconds": 4,
      "duration_seconds": 4,
      "composition_image_tag": "图片1",
      "start_state": "张咪右爪带粉，目光盯关咪；枪仍背着。",
      "end_state": "话落，张咪仍盯关咪，右爪离袋口；关咪尚未答。",
      "action": "张咪完整说出反问，不再捏一次豆。"
    },
    {
      "shot": "SHOT-EP001-019",
      "source_scene": "EP001-SC003",
      "name": "关咪护住余豆",
      "start_seconds": 4,
      "end_seconds": 8,
      "duration_seconds": 4,
      "composition_image_tag": "图片2",
      "start_state": "关咪双爪在售卖袋旁，袋口已有粉，张咪仍在摊前。",
      "end_state": "余豆在袋内受护，袋口粉不清掉；关咪扣袋、枪仍在车上。",
      "action": "关咪扣住袋口，把同一袋向自身侧护近，同时压低声回答；袋底始终留木摊。"
    },
    {
      "shot": "SHOT-EP001-020",
      "source_scene": "EP001-SC003",
      "name": "张咪追问分肉",
      "start_seconds": 8,
      "end_seconds": 12,
      "duration_seconds": 4,
      "composition_image_tag": "图片3",
      "start_state": "张咪面对护袋的关咪，背枪未取，右爪仍留粉。",
      "end_state": "质问说完，张咪仍在原摊前；枪未动。",
      "action": "张咪提出分肉质问，保持对视。"
    },
    {
      "shot": "SHOT-EP001-021",
      "source_scene": "EP001-SC003",
      "name": "规矩是你自己定的",
      "start_seconds": 12,
      "end_seconds": 18,
      "duration_seconds": 6,
      "composition_image_tag": "图片4",
      "start_state": "关咪扣着同一售卖袋，张咪在近侧听；枪均未取。",
      "end_state": "关咪话落仍护袋，张咪压力累积；粉保留，枪未动。",
      "action": "关咪完整说出搬盘与规矩的回应，不再演搬盘。"
    },
    {
      "shot": "SHOT-EP001-022",
      "source_scene": "EP001-SC003",
      "name": "拍摊要较量",
      "start_seconds": 18,
      "end_seconds": 23,
      "duration_seconds": 5,
      "composition_image_tag": "图片5",
      "start_state": "张咪右爪带粉在身前，关咪扣袋；张咪枪仍背着。",
      "end_state": "右爪停摊沿，张咪背枪未取；关咪仍护袋，摊未塌。",
      "action": "张咪右爪拍一下摊沿，随后完整说要见本事。"
    }
  ],
